# ===== 多租户 =====
REGISTRATION_CODES=LOCAL-TEST-CODE-0001
SESSION_COOKIE_NAME=auto_shoper_session
SESSION_DAYS=30
COOKIE_SECURE=false
# python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=
DATABASE_PATH=data/auto-shoper.db
UPLOAD_DIR=data/uploads
CORS_ALLOW_ORIGIN_REGEX=

# ===== 平台级国际站应用（所有租户共用，店铺 token 各存各的）=====
ALIBABA_APP_KEY=
ALIBABA_APP_SECRET=
ALIBABA_GATEWAY=https://openapi-api.alibaba.com/rest
ALIBABA_AUTHORIZE_URL=https://openapi-auth.alibaba.com/oauth/authorize
ALIBABA_APPEND_OPERATION_TO_URL=false
ALIBABA_TIMEOUT_SECONDS=30
# 必须和开放平台控制台里登记的回调地址完全一致，且指向本服务
ALIBABA_OAUTH_REDIRECT_URI=http://127.0.0.1:8000/api/v1/alibaba/oauth/callback
ALIBABA_OAUTH_SUCCESS_URL=http://127.0.0.1:8000/#/shops?alibaba=connected
ALIBABA_OAUTH_ERROR_URL=http://127.0.0.1:8000/#/shops?alibaba=error
# 仅本地调试：把这个 token 直接绑成一个店铺，跳过 OAuth
ALIBABA_ACCESS_TOKEN=

# ===== AI 成稿 =====
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
TEXT_MODEL=gpt-4o-mini
AI_TIMEOUT_SECONDS=120

# ===== 没图时平台出套图（Grsai gpt-image-2）=====
# 文档：https://grsai.ai/dashboard/documents/gpt-image
# 全球 https://api.grsai.com  国内 https://api.grsai.cn
GRSAI_API_KEY=
GRSAI_BASE_URL=https://api.grsai.com
IMAGE_MODEL=gpt-image-2
IMAGE_TIMEOUT_SECONDS=180
GENERATED_DIR=data/generated-images
