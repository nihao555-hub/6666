# 阿里国际站 / 淘宝开放平台（TOP）
# 从 https://open.taobao.com 应用管理里复制，不要提交真实值
ALIBABA_APP_KEY=
ALIBABA_APP_SECRET=

# 商家授权后的 session。没有的话先走 OAuth，不要把店铺密码交给系统
ALIBABA_SESSION_KEY=

# 正式环境。海外 ISV 可改成 https://api.taobao.com/router/rest
ALIBABA_GATEWAY=https://eco.taobao.com/router/rest

# OAuth 回调，必须和应用后台配置一致
ALIBABA_REDIRECT_URI=http://localhost:5173/oauth/callback
